{
  "format": "hypit.runtime-local@1",
  "dataRoot": ".hypit/execution",
  "credentials": { "env": { "use": "@hypit/credential-store-env" } },
  "endpoints": {
    "media.local": { "use": "@hypit/provider-media-local" },
    "whisperx.local": { "use": "@hypit/provider-whisperx-local", "config": { "expectedModel": "small", "expectedDevice": "cpu", "expectedCompute": "int8", "alignmentLanguages": ["zh", "en"] } },
    "hyperframes.local": { "use": "@hypit/provider-hyperframes-local" },
    "hypihub.default": { "use": "@hypit/provider-hypihub", "config": { "baseUrl": "https://hypit.ai", "apiKey": { "store": "env", "key": "HYPIT_HUB_API_KEY" } } }
  },
  "bindings": {
    "@hypit/whisperx@1#whisperx-alignment": "whisperx.local",
    "@hypit/seedance@1#seedance-2-mini": "hypihub.default"
  }
}
